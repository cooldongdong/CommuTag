{
	"mode": "development or production",
	"mongodb": {
		"url": "mongodb://mongo:27017/commutag"
	},
	"facebookAuth": {
		"enable": true,
		"clientID": "YOUR_FACEBOOK_CLIENT_ID",
		"clientSecret": "YOUR_FACEBOOK_CLIENT_SECRET",
		"callbackURL": "YOUR_FACEBOOK_LOGIN_CALLBACK"
	},
	"googleAuth": {
		"enable": true,
		"clientID": "YOUR_GOOGLE_CLIENT_ID",
		"clientSecret": "YOUR_GOOGLE_CLIENT_SECRET",
		"callbackURL": "YOUR_GOOGLE_LOGIN_CALLBACK"
	},
	"session": {
		"secret": "YOUR_SESSION_SECRET"
	},
	"jwt": {
		"secret": "YOUR_JWT_SECRET"
	},
	"hostname": "http://localhost",
	"siteName": "CommuTag",
	"desc": "一個讓社群分享、共同協作的圖片標註系統",
	"logo": "/static/image/logo.png",
	"serverPort": 8001,
	"version": "1.0.0",
	"defaultAdmin": {
		"provider": "google or facebook or local",
		"email": "YOUR_ADMIN_EMAIL"
	},
	"verify": {
		"sample": 10,
		"accept": 0.9,
		"reject": 0.7
	},
	"googleAnalytics": {
		"id": "YOUR_GOOGLE_ANALYTICS_ID"
	},
	"storage": {
		"endpoint": "https://<account-id>.r2.cloudflarestorage.com",
		"region": "auto",
		"bucket": "commutag",
		"accessKeyId": "",
		"secretAccessKey": "",
		"forcePathStyle": false
	},
	"email": {
		"enable": false,
		"sender": "YOUR_ELASTIC_EMAIL_SENDER",
		"smtp": {
			"host": "",
			"port": 587,
			"secure": false,
			"user": "",
			"pass": ""
		}
	}
}
